OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
DATABASE_PATH=data/mini-claude-bot.db

# Daily reports (optional)
REPORT_SENDER=you@example.com
REPORT_TO_PRIMARY=recipient1@example.com
REPORT_CC=recipient2@example.com
REPORT_TO_SECONDARY=recipient3@example.com

# Dashboard metrics (optional)
DASHBOARD_PUSH_URL=
METRICS_SECRET=

# Gateway session tuning (optional)
# How long a queued message waits for a busy session before returning [BUSY] (seconds).
# Raised from 120 -> 300 so /confirm and follow-ups queue behind in-flight work
# instead of bouncing off a premature [BUSY]. Keep below GATEWAY_BUSY_STUCK_TIMEOUT (660).
GATEWAY_QUEUE_WAIT_TIMEOUT=300
# Idle interactive session timeout before reclamation (seconds). Default 3600 (1h).
GATEWAY_SESSION_IDLE_TIMEOUT=3600
# Harness auto/normal mode + grill-me self-clarification (issue #11). OFF by default:
# unset reproduces the original Phase-1 prompt exactly. When enabled, a harness
# message carrying an explicit auto token ('auto mode' / 'automode' / '/auto' /
# '自动模式') self-grills and executes without a /confirm round; other messages get
# a grill-me interview. Affects every tenant's harness loop — toggle deliberately.
GATEWAY_HARNESS_AUTO_MODE=0
